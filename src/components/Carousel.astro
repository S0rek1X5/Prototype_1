---
const slides = [
    {
        image: `${import.meta.env.BASE_URL}Dep_1.jpg`,
        title: "We provide premium courts for both individual and group training",
        description: "Our advanced sports facilities boast diverse courts and fields for every athlete.",
        linkText: "Book a Court",
        linkUrl: "/sportcenter"
    },
    {
        image: `${import.meta.env.BASE_URL}Dep_2.jpg`,
        title: "Top-Tier Sports Facilities for Training",
        description: "Designed to help athletes reach their maximum potential with professional equipment.",
        linkText: "Explore More",
        linkUrl: "/sportcenter"
    },
    {
        image: `${import.meta.env.BASE_URL}Dep_3.jpg`,
        title: "Versatile Sports Facilities Designed for Performance",
        description: "Multi-purpose areas built to host competitions and casual matches alike.",
        linkText: "View Facilities",
        linkUrl: "/sportcenter"
    },
    {
        image: `${import.meta.env.BASE_URL}Dep_4.jpg`,
        title: "Professional Coaching & Training Zones",
        description: "Get personalized guidance from expert trainers in a world-class environment.",
        linkText: "Learn More",
        linkUrl: "/sportcenter"
    },
    {
        image: `${import.meta.env.BASE_URL}Dep_5.jpg`,
        title: "Exclusive Membership Benefits & Access",
        description: "Join our community and enjoy priority booking across all locations.",
        linkText: "Join Now",
        linkUrl: "/membership"
    }
];
---




<main>

    <div class="bg-[#5a8267] p-8 rounded-3xl text-white lg:w-fit md:h-fit relative shadow-lg my-10">
        <div class="flex flex-col md:flex-row items-center gap-8">
    
    
        <div class="md:w-sm md:h-sm">
            <img id="carousel-img" src={slides[0].image} alt="Facility" class="rounded-2xl object-cover h-[300px] w-full shadow-md" />
        </div>

    
        <div class="w-fit h-fit md:w-1/2 flex flex-col justify-between">
            <div>
                <h2 id="carousel-title" class="text-2xl md:text-3xl font-medium mb-4">{slides[0].title}</h2>
                <p id="carousel-desc" class="text-gray-100 text-sm mb-8">{slides[0].description}</p>
            </div>

            <div class="md:flex flex-col items-center justify-between">
        
                <a id="carousel-link" href={slides[0].linkUrl} class="self-start  sm:h-fit bg-black text-white px-3 py-2 rounded-full flex items-center gap-3 hover:bg-neutral-800 transition-colors">
                    <span id="carousel-link-text">{slides[0].linkText}</span>
                    <span class="bg-white text-black rounded-full p-1 w-6 h-6 flex items-center justify-center xs:text-xs">↗</span>
                </a>

        
                <div class="flex items-center gap-4">
                    <span id="carousel-counter" class="text-sm font-medium">1/{slides.length}</span>
                    <button id="prev-btn" aria-label="Anterior" class="bg-black text-white p-3 rounded-full hover:bg-neutral-800 transition-colors cursor-pointer">
                    ←
                    </button>
                    <button id="next-btn" aria-label="Siguiente" class="bg-black text-white p-3 rounded-full hover:bg-neutral-800 transition-colors cursor-pointer">
                    →
                    </button>
                </div>
            </div>
        </div>

        </div>
    </div>


    <script define:vars={{ slides }}>
    let currentIndex = 0;
    const totalSlides = slides.length;

    const imgEl = document.getElementById('carousel-img');
    const titleEl = document.getElementById('carousel-title');
    const descEl = document.getElementById('carousel-desc');
    const linkEl = document.getElementById('carousel-link');
    const linkTextEl = document.getElementById('carousel-link-text');
    const counterEl = document.getElementById('carousel-counter');

    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');

    function updateView(index) {
        const data = slides[index];
        imgEl.src = data.image;
        titleEl.textContent = data.title;
        descEl.textContent = data.description;
        linkEl.href = data.linkUrl;
        linkTextEl.textContent = data.linkText;
        counterEl.textContent = `${index + 1}/${totalSlides}`;
    }

    prevBtn.addEventListener('click', () => {
        currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
        updateView(currentIndex);
    });

    nextBtn.addEventListener('click', () => {
        currentIndex = (currentIndex + 1) % totalSlides;
        updateView(currentIndex);
    });
    </script>
    
</main>