---
// src/components/Footer.astro
---
<footer class="bg-gray-200 text-black py-12 px-6 lg:px-12">
  <!-- Contenedor principal: 1 columna en móvil, 2 en tablet (md), 5 en escritorios grandes (xl) -->
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-8">
    
    <!-- Columna 1: Logo y Descripción -->
    <div class="flex flex-col space-y-4">
      <div class="flex items-center gap-x-3">
        <img src="/src/assets/Logos.png" alt="Logo" class="w-10 h-10 object-cover rounded-full" />
        <h1 class="text-xl font-semibold text-black">ProtoFitness</h1>
      </div>
      <p class="text-sm font-bold text-black max-w-xs">
        Your Play, Your Way - Modern Sports Facilities for Every Passion
      </p>
    </div>

    <!-- Columna 2: Facilities -->
    <div class="flex flex-col space-y-2 text-left">
      <h3 class="text-lg font-semibold text-black mb-2">Facilities</h3>
      <a href="/TennisCourts" class="text-sm text-black hover:text-gray-700 transition-colors">Tennis Courts</a>
      <a href="/BasketballCourts" class="text-sm text-black hover:text-gray-700 transition-colors">Basketball Courts</a>
      <a href="/FootballField" class="text-sm text-black hover:text-gray-700 transition-colors">Football Field</a>
      <a href="/SwimmingPools" class="text-sm text-black hover:text-gray-700 transition-colors">Swimming Pools</a>
      <a href="/GymFitness" class="text-sm text-black hover:text-gray-700 transition-colors">GymFitness</a>
      <a href="/Center" class="text-sm text-black hover:text-gray-700 transition-colors">Center</a>
      <a href="/Multi-purpose Hall" class="text-sm text-black hover:text-gray-700 transition-colors">Multi-purpose Hall</a>
      <a href="/YogaStudio" class="text-sm text-black hover:text-gray-700 transition-colors">Yoga Studio</a>
      <a href="/DanceStudio" class="text-sm text-black hover:text-gray-700 transition-colors">Zone</a>
      <a href="/MartialArts" class="text-sm text-black hover:text-gray-700 transition-colors">Locker Rooms</a>
    </div>

    <!-- Columna 3: About -->
    <div class="flex flex-col space-y-2 text-left">
      <h3 class="text-lg font-semibold text-black mb-2">About</h3>
      <a href="/AboutUs" class="text-sm text-black hover:text-gray-700 transition-colors">Our Mission</a>
      <a href="/ContactUs" class="text-sm text-black hover:text-gray-700 transition-colors">Vision</a>
      <a href="/Careers" class="text-sm text-black hover:text-gray-700 transition-colors">Community</a>
    </div>

    <!-- Columna 4: Social -->
    <div class="flex flex-col space-y-2 text-left">
      <h3 class="text-lg font-semibold text-black mb-2">Social</h3>
      <a href="/FAQ" class="text-sm text-black hover:text-gray-700 transition-colors">Instagram</a>
      <a href="/ContactUs" class="text-sm text-black hover:text-gray-700 transition-colors">Facebook Us</a>
      <a href="/PrivacyPolicy" class="text-sm text-black hover:text-gray-700 transition-colors">Linkedin</a>
      <a href="/TermsOfService" class="text-sm text-black hover:text-gray-700 transition-colors">Youtube</a>
    </div>

    <!-- Columna 5: Formulario de contacto (Join Us) -->
    <div class="flex flex-col gap-y-3 w-full bg-transparent xl:col-span-1 md:col-span-2">
      <h3 class="text-lg font-medium text-black text-left">Join Us</h3>

      <input 
        type="email" 
        placeholder="Type your email..." 
        class="w-full px-5 py-3.5 bg-white text-gray-800 placeholder-gray-400 rounded-full border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black transition-all text-sm shadow-sm"
      />

      <input 
        type="text" 
        placeholder="Type your name here..." 
        class="w-full px-5 py-3.5 bg-white text-gray-800 placeholder-gray-400 rounded-full border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black transition-all text-sm shadow-sm"
      />

      <select class="w-full px-5 py-3.5 bg-white text-gray-500 rounded-full border border-gray-200 focus:outline-none focus:ring-2 focus:ring-black transition-all text-sm shadow-sm appearance-none cursor-pointer">
        <option value="" disabled selected>Training Type</option>
        <option value="option1">Opción 1</option>
        <option value="option2">Opción 2</option>
      </select>

      <button type="submit" class="w-full flex items-center justify-between px-6 py-2.5 bg-black text-white rounded-full hover:bg-gray-800 transition-all font-medium text-sm shadow-md group cursor-pointer">
        <span>Book a Court</span>
        <span class="flex items-center justify-center w-8 h-8 bg-white text-black rounded-full transition-transform group-hover:scale-105">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M17 7H7M17 7v10" />
          </svg>
        </span>
      </button>
    </div>

  </div>
</footer>