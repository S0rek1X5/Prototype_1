---

import Layout from '../layouts/Layout.astro';

import Footer from '../components/Footer.astro';

---

<Layout>
	<div class="flex flex-col justify-center px-55 py-10"> <!-- Este es un comentario en HTML -->
	<div class="bg-[url('/fondo.jpg')] bg-black/30 bg-blend-overlay bg-cover bg-center bg-no-repeat w-full rounded-3xl px-10 py-5 ">
			<div class="flex flex-row justify-between font-medium text-sm text-white">  <!--header-->
				<div class="flex gap-3 items-center">
					<a href="/About_us" class="inline-flex items-center justify-center bg-transparent hover:bg-gray-200 border-3 border-white-500 rounded-full px-4 py-1">
						<span class="truncate">About Us</span>
					</a>
					<a href="/Offer" class="inline-flex items-center justify-center bg-transparent hover:bg-gray-200 border-3 border-white-500 rounded-full px-4 py-1">
						<span class="truncate">Offer</span>
					</a>
					<a href="/Facilities" class="inline-flex items-center justify-center bg-transparent hover:bg-gray-200 border-3 border-white-500 rounded-full px-4 py-1">
						<span class="truncate">Facilities</span>
					</a>
					<a href="/Membership" class="inline-flex items-center justify-center bg-transparent hover:bg-gray-200 border-3 border-white-200 rounded-full px-4 py-1">
						<span class="truncate">Membership</span>
					</a>
				</div>
				<div class="absolute left-1/2 top-8 -translate-x-1/2 bg-white rounded-b-[3rem] px-6 pt-3 pb-5 flex flex-col items-center justify-center "><img class="w-25 h-15 rounded-full" src="src\assets\Logos.png" alt="Logo"/></div>
				<div class="flex justify-around items-center gap-3">
					<form action="/search" method="GET" class="relative flex items-center">
  						<input 
    						type="text" 
    						name="q"
    						placeholder="Search here..." 
    						class=" bg-transparent placeholder-white border-2 border-white rounded-full py-2 pl-3 outline-none focus:ring-2 focus:ring-white/50 transition-all"
  						/>
  						<button 
    						type="submit" 
    						aria-label="Search"
    						class="absolute right-1.5 flex items-center justify-center w-8 h-8 bg-white text-black rounded-full hover:bg-gray-200 transition-colors"
  						>
    						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      							<circle cx="11" cy="11" r="8"></circle>
      							<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
    						</svg>
  						</button>
					</form>
					<a href="/Book_Now" class="inline-flex items-center gap-3 bg-black hover:bg-neutral-800 pl-4 pr-1 py-1 rounded-full transition-colors">
						<span>Book Now</span>
  						<span class="flex items-center justify-center w-7 h-7 bg-white text-black rounded-full">
    						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
      							<path d="M7 17L17 7"/>
      							<path d="M7 7h10v10"/>
    						</svg>
  						</span>
					</a>
					<button aria-label="Abrir menú de navegación" class="px-1 text-white hover:bg-white/10 rounded-lg">
  						<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    						<line x1="4" y1="12" x2="20" y2="12"></line>
    						<line x1="4" y1="6" x2="20" y2="6"></line>
    						<line x1="4" y1="18" x2="20" y2="18"></line>
  						</svg>
					</button>
				</div>
			</div>

			<div class="flex flex-row justify-between px-1 pt-25">
				<div class="flex flex-col text-white font-normal text-sm"> <!--col1-->
					<div class="flex flex-row w-fit p-1 bg-white/30 rounded-full -space-x-2">
						<img class="w-10 h-10 rounded-full" src="src\assets\ryuki.jpg" alt="Trainers"/>
						<img class="w-10 h-10 rounded-full" src="src\assets\ryuki.jpg" alt="Trainers"/>
						<img class="w-10 h-10 rounded-full" src="src\assets\ryuki.jpg" alt="Trainers"/>
					</div>
					<p class="w-3xs text-sm/4 pt-2">We're committed to delivering a high-quality experience in a welcomming and spportive atmosphere.</p>
					<p class="w-3xs pt-5 pb-2">All in one-sports facilities center</p>
					<a href="/membership" class="inline-flex items-center justify-center bg-black hover:bg-neutral-800 pl-4 pr-1 py-1 w-fit rounded-full transition-colors">
						<span class="px-1">Join with us</span>
  						<span class="flex items-center justify-center w-7 h-7 bg-white text-black rounded-full">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
	  							<path d="M7 17L17 7"/>
	  							<path d="M7 7h10v10"/>
							</svg>
  						</span>
					</a>
					<h1 class="py-10 pt-15 text-5xl w-xl leading-tight tracking-wider">Refresh,Relax and Rediscover Life's simple Pleasures</h1>
					<h2 class="w-135 leading-tight">Rediscover the beauty in life's simplest pleasures, and let every moment here remind you of the joy of true relaxation.</h2>
				
				</div>
			

				<div class="flex items-end flex-col gap-y-5"> <!--col2-->
					<div class="pb-30 gap-2 flex flex-col items-end text-black font-medium text-sm ">
						<a href="/https://www.instagram.com/" class="w-fit px-5 bg-white hover:bg-gray-200 inline-flex justify-center p-2 rounded-full transition-colors">instagram</a>
						<a href="/https://www.x.com/" class="w-fit px-5 bg-white hover:bg-gray-200 inline-flex justify-center p-2 rounded-full transition-colors">Twitter</a>
						<a href="/https://www.facebook.com/" class="w-fit px-5 bg-white hover:bg-gray-200 inline-flex justify-center p-2 rounded-full transition-colors">Facebook</a>
					</div>
					<div class="text-white text-sm gap-3 bg-white/40 py-4 px-5 rounded-2xl">
						<h1 class="font-medium text-2xl">Refer a friend</h1>
						<h2 class="pb-9">share your referral link with friends</h2>
						<div class="flex flex-row items-center gap-x-2 py-1 pb-1 rounded-full ">
							<a href="/share" class="inline-flex items-center gap-3 bg-white hover:bg-gray-100 text-black text-md font-semibold px-5 py-2 h-fit rounded-full transition-colors shadow-sm">
  								<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      								<circle cx="18" cy="5" r="3"></circle>
      								<circle cx="6" cy="12" r="3"></circle>
      								<circle cx="18" cy="19" r="3"></circle>
      								<line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
      								<line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
    							</svg>
    							<span class="text-black ">Share link</span>
  							</a>

							<div class="flex flex-row w-fit p-1 bg-white/30 rounded-full -space-x-2">
								<img class="w-10 h-10 rounded-full" src="src\assets\ryuki.jpg" alt="Trainers"/>
								<img class="w-10 h-10 rounded-full" src="src\assets\ryuki.jpg" alt="Trainers"/>
								<img class="w-10 h-10 rounded-full" src="src\assets\ryuki.jpg" alt="Trainers"/>
								<img class="w-10 h-10 rounded-full" src="src\assets\ryuki.jpg" alt="Trainers"/>
							</div>
						</div>
					</div>
					<div class="gap-2 text-md font-normal text-black flex flex-col items-start bg-white/80 p-5 rounded-2xl">
						<span class="leading-none w-20">Download our @App</span>
						<a href="/download" download class="inline-flex items-center gap-3 bg-white hover:bg-gray-100 text-black font-semibold border border-black rounded-full px-3 py-1 h-fit transition-colors shadow-sm">
  							<svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"></circle><path d="M12 8v8"></path><path d="m8 12 4 4 4-4"></path>
							</svg>
  							<span>Download</span>
						</a>
					</div>
				</div>
			</div>
		</div>
		
		

		<div class="flex flex-row gap-x-10 font-medium pt-15 border-b-1 border-gray-300 pb-10">
			<div class="flex items-start flex-col gap-y-3 text-black p-5">
				<a href="/sportcenter" class="rounded-4xl border-3 border-gray-300 p-1 px-5	">
					<span>Sports center</span>
				</a>
				<h1 class="text-2xl text-black font-semibold w-80 pb-5">Welcome to Velocity Club, where we inspire athletes and fitness enthusiassts to reach new heights.</h1>
				<a href="/membership" class="text-white inline-flex justify-center bg-black hover:bg-neutral-800 pl-4 pr-1 py-1 w-fit rounded-full transition-colors">
					<span class="px-1">Get in touch</span>
  					<span class="flex items-center justify-center w-7 h-7 bg-white text-black rounded-full">
						<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
	  						<path d="M7 17L17 7"/>
							<path d="M7 7h10v10"/>
						</svg>
  					</span>
				</a>
			</div>
			<div class="px-5 pt-5 pb-3  text-white font-medium flex flex-col items-start justify-between rounded-2xl bg-[url('/Skie.jpg')] bg-black/10 bg-blend-overlay bg-cover bg-center">
				<a href="/sportcenter" class="rounded-4xl border-3 border-gray-300 p-1 px-5	">
					<span>Sports center</span>
				</a>
				<div class="text-white font-medium flex flex-row gap-x-4">
					<span class="w-58">Versatile space for a wide range of activities</span>
					<a href="/membership" class="">
  						<span class="flex items-center justify-center w-7 h-7 bg-black text-white rounded-full">
							<svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
	  							<path d="M7 17L17 7"/>
								<path d="M7 7h10v10"/>
							</svg>
  						</span>
					</a>
				</div>
			</div>
			<div class=" bg-[url('/cesped.jpg')] bg-cover bg-center bg-no-repeat rounded-2xl w-80 h-50">
				<div class="flex flex-col p-5	flex items-start gap-y-25 text-white font-medium">
					<a href="/sportcenter" class="rounded-4xl border-3 border-gray-300 p-1 px-5	">
						<span>Sports center</span>
					</a>
					<h1>Futal court</h1>
				</div>
				<div class="flex flex-row justify-between">
					<span class="w-60 leading-tight pt-2">Explore the ideal space to play, train, and reach new heights. Where passion meets</span>
				</div>
			</div>
		</div>

		<div class="section_fontPage_2">
			<div class="section_fontPage_2_container_1">
			</div>
			<div class="section_fontPage_2_container_2">
			</div>
		</div>

		<div class="section_fontPage_3">
			<div class="section_fontPage_3_container_1">
			</div>
			<div class="section_fontPage_3_container_2">
			</div>
			<div class="section_fontPage_3_container_3">
			</div>
		</div>

		<div class="section_fontPage_4">
			<div class="section_fontPage_4_container_1">
			</div>
			<div class="section_fontPage_4_container_2">
			</div>
		</div>

		<div class="section_fontPage_5">
			<div class="section_fontPage_5_container_1">
			</div>
			<div class="section_fontPage_5_container_2">
				<div class="section_fontPage_5_sub_container_1">
				</div>
				<div class="section_fontPage_5_sub_container_2">
				</div>
			</div>
		</div>
		
		<div class="section_fontPage_6">
			<div class="section_fontPage_6_container_1">
			</div>
			<div class="section_fontPage_6_container_2">
			</div>
		</div>
	</div>
	<div class="footer"><div class="footer_container_1"></div> </div>
</Layout>