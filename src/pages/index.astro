---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
    <!-- Contenedor principal responsive con padding adaptativo -->
    <div class="flex flex-col justify-center px-4 sm:px-8 md:px-12 lg:px-20 py-6 lg:py-10">
        
        <!-- Sección de Cabecera y Banner Principal con Fondo -->
        <div class="flex flex-col bg-[url('/fondo.jpg')] bg-black/30 bg-blend-overlay bg-cover bg-center bg-no-repeat w-full rounded-3xl px-4 sm:px-8 py-6">
            
            <!-- Header adaptable -->
            <div class="flex flex-col lg:flex-row justify-between items-center gap-6 font-medium text-sm text-white">
                
                <!-- Navegación de Enlaces (Oculta en móviles, visible en pantallas grandes o adaptable) -->
                <div class="flex flex-wrap justify-center lg:justify-start gap-2 sm:gap-3 items-center">
                    <a href="/About_us" class="inline-flex items-center justify-center bg-transparent hover:bg-gray-200 hover:text-black border-2 border-white rounded-full px-4 py-1 transition-colors">
                        <span class="truncate">About Us</span>
                    </a>
                    <a href="/Offer" class="inline-flex items-center justify-center bg-transparent hover:bg-gray-200 hover:text-black border-2 border-white rounded-full px-4 py-1 transition-colors">
                        <span class="truncate">Offer</span>
                    </a>
                    <a href="/Facilities" class="inline-flex items-center justify-center bg-transparent hover:bg-gray-200 hover:text-black border-2 border-white rounded-full px-4 py-1 transition-colors">
                        <span class="truncate">Facilities</span>
                    </a>
                    <a href="/Membership" class="inline-flex items-center justify-center bg-transparent hover:bg-gray-200 hover:text-black border-2 border-white rounded-full px-4 py-1 transition-colors">
                        <span class="truncate">Membership</span>
                    </a>
                </div>

                <!-- Logo Central (Adaptado sin absolute estricto para evitar solapamientos en móvil) -->
                

                <!-- Buscador, Botón y Menú Hamburguesa -->
                <div class="flex flex-wrap justify-center items-center gap-3">
                    <form action="/search" method="GET" class="relative flex items-center">
                        <input 
                            type="text" 
                            name="q"
                            placeholder="Search here..." 
                            class="bg-transparent placeholder-white text-white border-2 border-white rounded-full py-2 pl-3 pr-10 outline-none focus:ring-2 focus:ring-white/50 transition-all text-xs sm:text-sm w-36 sm:w-48"
                        />
                        <button 
                            type="submit" 
                            aria-label="Search"
                            class="absolute right-1.5 flex items-center justify-center w-7 h-7 sm:w-8 sm:h-8 bg-white text-black rounded-full hover:bg-gray-200 transition-colors"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </button>
                    </form>

                    <a href="/Book_Now" class="inline-flex items-center gap-2 sm:gap-3 bg-black hover:bg-neutral-800 pl-4 pr-1 py-1 rounded-full transition-colors text-white">
                        <span>Book Now</span>
                        <span class="flex items-center justify-center w-7 h-7 bg-white text-black rounded-full">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M7 17L17 7"/>
                                <path d="M7 7h10v10"/>
                            </svg>
                        </span>
                    </a>

                    <button aria-label="Abrir menú de navegación" class="p-1 text-white hover:bg-white/10 rounded-lg">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="4" y1="12" x2="20" y2="12"></line>
                            <line x1="4" y1="6" x2="20" y2="6"></line>
                            <line x1="4" y1="18" x2="20" y2="18"></line>
                        </svg>
                    </button>
                </div>
            </div>

            <!-- Contenido Central del Banner (Columnas responsivas) -->
            <div class="flex flex-col lg:flex-row justify-between px-1 pt-12 lg:pt-25 gap-10">
                
                <!-- Columna 1 -->
                <div class="flex flex-col text-white font-normal text-sm w-full lg:max-w-xl">
                    <div class="flex flex-row w-fit p-1 bg-white/30 rounded-full -space-x-2">
                        <img class="w-10 h-10 rounded-full object-cover" src="/src/assets/ryuki.jpg" alt="Trainers"/>
                        <img class="w-10 h-10 rounded-full object-cover" src="/src/assets/ryuki.jpg" alt="Trainers"/>
                        <img class="w-10 h-10 rounded-full object-cover" src="/src/assets/ryuki.jpg" alt="Trainers"/>
                    </div>
                    <p class="max-w-xs text-xs sm:text-sm pt-2">We're committed to delivering a high-quality experience in a welcoming and supportive atmosphere.</p>
                    <p class="max-w-xs pt-3 pb-2 text-xs sm:text-sm">All in one-sports facilities center</p>
                    
                    <a href="/membership" class="inline-flex items-center justify-center bg-black hover:bg-neutral-800 pl-4 pr-1 py-1 w-fit rounded-full transition-colors text-white">
                        <span class="px-1">Join with us</span>
                        <span class="flex items-center justify-center w-7 h-7 bg-white text-black rounded-full">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M7 17L17 7"/>
                                <path d="M7 7h10v10"/>
                            </svg>
                        </span>
                    </a>

                    <h1 class="py-6 lg:py-10 text-3xl sm:text-4xl lg:text-5xl leading-tight tracking-wider">Refresh, Relax and Rediscover Life's simple Pleasures</h1>
                    <h2 class="text-sm sm:text-base leading-tight opacity-90">Rediscover the beauty in life's simplest pleasures, and let every moment here remind you of the joy of true relaxation.</h2>
                </div>

                <!-- Columna 2 -->
                <div class="flex items-start lg:items-end flex-col gap-y-5 w-full lg:w-auto">
                    <!-- Redes sociales -->
                    <div class="pb-6 lg:pb-30 gap-2 flex flex-row lg:flex-col items-start lg:items-end text-black font-medium text-sm flex-wrap">
                        <a href="https://www.instagram.com/" target="_blank" rel="noopener noreferrer" class="w-fit px-4 sm:px-5 bg-white hover:bg-gray-200 inline-flex justify-center p-2 rounded-full transition-colors">instagram</a>
                        <a href="https://www.x.com/" target="_blank" rel="noopener noreferrer" class="w-fit px-4 sm:px-5 bg-white hover:bg-gray-200 inline-flex justify-center p-2 rounded-full transition-colors">Twitter</a>
                        <a href="https://www.facebook.com/" target="_blank" rel="noopener noreferrer" class="w-fit px-4 sm:px-5 bg-white hover:bg-gray-200 inline-flex justify-center p-2 rounded-full transition-colors">Facebook</a>
                    </div>

                    <!-- Referencia de amigos -->
                    <div class="text-white text-sm gap-3 bg-white/40 backdrop-blur-sm py-4 px-5 rounded-2xl w-full sm:w-auto">
                        <h1 class="font-medium text-xl sm:text-2xl">Refer a friend</h1>
                        <h2 class="pb-6 text-xs sm:text-sm">share your referral link with friends</h2>
                        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 py-1 rounded-full">
                            <a href="/share" class="inline-flex items-center gap-3 bg-white hover:bg-gray-100 text-black text-sm sm:text-md font-semibold px-4 sm:px-5 py-2 h-fit rounded-full transition-colors shadow-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="18" cy="5" r="3"></circle>
                                    <circle cx="6" cy="12" r="3"></circle>
                                    <circle cx="18" cy="19" r="3"></circle>
                                    <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
                                    <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
                                </svg>
                                <span>Share link</span>
                            </a>
                            <div class="flex flex-row w-fit p-1 bg-white/30 rounded-full -space-x-2">
                                <img class="w-8 h-8 sm:w-10 sm:h-10 rounded-full object-cover" src="/src/assets/ryuki.jpg" alt="Trainers"/>
                                <img class="w-8 h-8 sm:w-10 sm:h-10 rounded-full object-cover" src="/src/assets/ryuki.jpg" alt="Trainers"/>
                                <img class="w-8 h-8 sm:w-10 sm:h-10 rounded-full object-cover" src="/src/assets/ryuki.jpg" alt="Trainers"/>
                                <img class="w-8 h-8 sm:w-10 sm:h-10 rounded-full object-cover" src="/src/assets/ryuki.jpg" alt="Trainers"/>
                            </div>
                        </div>
                    </div>

                    <!-- Descargar App -->
                    <div class="gap-2 text-md font-normal text-black flex flex-col items-start bg-white/80 backdrop-blur-sm p-5 rounded-2xl w-full sm:w-auto">
                        <span class="leading-none text-xs sm:text-sm">Download our @App</span>
                        <a href="/download" download class="inline-flex items-center gap-3 bg-white hover:bg-gray-100 text-black font-semibold border border-black rounded-full px-3 py-1 h-fit transition-colors shadow-sm text-xs sm:text-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 sm:w-6 sm:h-6 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"></circle><path d="M12 8v8"></path><path d="m8 12 4 4 4-4"></path>
                            </svg>
                            <span>Download</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Sección de Tarjetas Inferiores / Deportes -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 font-medium pt-10 lg:pt-15 border-b border-gray-300 pb-10">
            
            <div class="flex items-start flex-col gap-y-3 text-black p-3 sm:p-5">
                <a href="/sportcenter" class="rounded-full border-2 border-gray-300 p-1 px-4 text-xs sm:text-sm">
                    <span>Sports center</span>
                </a>
                <h1 class="text-xl sm:text-2xl text-black font-semibold pb-5">Welcome to Velocity Club, where we inspire athletes and fitness enthusiasts to reach new heights.</h1>
                <a href="/membership" class="text-white inline-flex justify-center bg-black hover:bg-neutral-800 pl-4 pr-1 py-1 w-fit rounded-full transition-colors">
                    <span class="px-1">Get in touch</span>
                    <span class="flex items-center justify-center w-7 h-7 bg-white text-black rounded-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M7 17L17 7"/>
                            <path d="M7 7h10v10"/>
                        </svg>
                    </span>
                </a>
            </div>

            <div class="p-5 text-white font-medium flex flex-col items-start justify-between rounded-2xl bg-[url('/Skie.jpg')] bg-black/30 bg-blend-overlay bg-cover bg-center min-h-[250px]">
                <a href="/sportcenter" class="rounded-full border-2 border-white p-1 px-4 text-xs sm:text-sm">
                    <span>Sports center</span>
                </a>
                <div class="text-white font-medium flex flex-row justify-between w-full items-end gap-x-4">
                    <span class="text-sm sm:text-base">Versatile space for a wide range of activities</span>
                    <a href="/membership">
                        <span class="flex items-center justify-center w-7 h-7 bg-black text-white rounded-full">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M7 17L17 7"/>
                                <path d="M7 7h10v10"/>
                            </svg>
                        </span>
                    </a>
                </div>
            </div>

            <div class="bg-[url('/cesped.jpg')] bg-cover bg-center bg-no-repeat rounded-2xl p-5 flex flex-col justify-between min-h-[250px] md:col-span-2 lg:col-span-1">
                <div class="flex flex-col items-start gap-y-4 text-white font-medium">
                    <a href="/sportcenter" class="rounded-full border-2 border-white p-1 px-4 text-xs sm:text-sm">
                        <span>Sports center</span>
                    </a>
                    <h1 class="text-xl font-semibold">Futsal court</h1>
                </div>
                <div class="flex flex-row justify-between text-white">
                    <span class="text-xs sm:text-sm leading-tight pt-2 opacity-90">Explore the ideal space to play, train, and reach new heights. Where passion meets...</span>
                </div>
            </div>

        </div>

    </div>
    
</Layout>